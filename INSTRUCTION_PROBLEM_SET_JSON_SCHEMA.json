{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://calculus-teachable-agent.local/pipeline-manifest.schema.json",
  "title": "Instruction Problem-Set Pipeline Manifest",
  "description": "Compatibility entry point for a manifest that lists and embeds all nine validated pipeline outputs. The former monolithic generation package is superseded.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "scenarioId", "outputs"],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0",
      "description": "Version of the multi-stage pipeline manifest contract."
    },
    "scenarioId": {
      "type": "integer",
      "minimum": 1,
      "description": "Positive scenario identifier that must match every embedded intermediate output."
    },
    "outputs": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "prefixItems": [
        { "$ref": "#/$defs/output01" },
        { "$ref": "#/$defs/output02" },
        { "$ref": "#/$defs/output03" },
        { "$ref": "#/$defs/output04" },
        { "$ref": "#/$defs/output05" },
        { "$ref": "#/$defs/output06" },
        { "$ref": "#/$defs/output07" },
        { "$ref": "#/$defs/output08" },
        { "$ref": "#/$defs/output09" }
      ],
      "items": false,
      "description": "The nine stage outputs in deterministic execution order."
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "document"],
      "properties": {
        "filename": { "type": "string", "description": "Required output filename." },
        "document": { "type": "object", "description": "Parsed JSON document validated by its stage schema." }
      }
    },
    "output01": {
      "allOf": [
        { "$ref": "#/$defs/entry" },
        { "properties": { "filename": { "const": "01-generation-plan.json" }, "document": { "$ref": "instruction-generator/schemas/01-generation-plan.schema.json" } } }
      ]
    },
    "output02": {
      "allOf": [
        { "$ref": "#/$defs/entry" },
        { "properties": { "filename": { "const": "02-scenario.json" }, "document": { "$ref": "instruction-generator/schemas/02-scenario.schema.json" } } }
      ]
    },
    "output03": {
      "allOf": [
        { "$ref": "#/$defs/entry" },
        { "properties": { "filename": { "const": "03-plot-data.json" }, "document": { "$ref": "instruction-generator/schemas/03-plot-data.schema.json" } } }
      ]
    },
    "output04": {
      "allOf": [
        { "$ref": "#/$defs/entry" },
        { "properties": { "filename": { "const": "04-student-task.json" }, "document": { "$ref": "instruction-generator/schemas/04-student-task.schema.json" } } }
      ]
    },
    "output05": {
      "allOf": [
        { "$ref": "#/$defs/entry" },
        { "properties": { "filename": { "const": "05-rubric.json" }, "document": { "$ref": "instruction-generator/schemas/05-rubric.schema.json" } } }
      ]
    },
    "output06": {
      "allOf": [
        { "$ref": "#/$defs/entry" },
        { "properties": { "filename": { "const": "06-sample-answers.json" }, "document": { "$ref": "instruction-generator/schemas/06-sample-answers.schema.json" } } }
      ]
    },
    "output07": {
      "allOf": [
        { "$ref": "#/$defs/entry" },
        { "properties": { "filename": { "const": "07-ai-student-answers.json" }, "document": { "$ref": "instruction-generator/schemas/07-ai-student-answers.schema.json" } } }
      ]
    },
    "output08": {
      "allOf": [
        { "$ref": "#/$defs/entry" },
        { "properties": { "filename": { "const": "08-line-grading.json" }, "document": { "$ref": "instruction-generator/schemas/08-line-grading.schema.json" } } }
      ]
    },
    "output09": {
      "allOf": [
        { "$ref": "#/$defs/entry" },
        { "properties": { "filename": { "const": "09-module.json" }, "document": { "$ref": "instruction-generator/schemas/09-module.schema.json" } } }
      ]
    }
  },
  "$comment": "Validate referenced schemas with a resolver rooted at this repository. Every intermediate document's scenarioId must equal the manifest scenarioId. Stage 09 intentionally omits schemaVersion and scenarioId because it is the exact app module."
}
